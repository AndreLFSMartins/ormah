{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ormah",
  "version": "0.1.0",
  "identifier": "dev.ormah.desktop",
  "build": {
    "frontendDist": "../onboarding"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "externalBin": ["binaries/ormah-server"],
    "category": "Productivity",
    "shortDescription": "Ambient memory for your AI agents",
    "longDescription": "Ormah is a local-first persistent memory system for AI agents. The menubar app keeps your ambient whisper counter in view, bundles the server, and wires your agents with one click.",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": null,
      "entitlements": "entitlements.plist",
      "exceptionDomain": "127.0.0.1"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://ormah.dev/appcast/{{target}}/{{arch}}/{{current_version}}"
      ],
      "pubkey": "REPLACE_WITH_TAURI_SIGNING_PUBLIC_KEY"
    }
  }
}
