<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- The bundled frozen Python server is JIT-free, but PyInstaller/torch may
       need an unsigned-executable-memory allowance under the hardened runtime.
       Keep these minimal; tighten once the frozen build is profiled on a Mac. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- Outbound localhost only; the app talks to 127.0.0.1:<port>. -->
  <key>com.apple.security.network.client</key>
  <true/>
</dict>
</plist>
