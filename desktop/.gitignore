# Rust / Tauri build output
src-tauri/target/
src-tauri/gen/

# Frozen sidecar binaries (produced by scripts/build-sidecar.sh at build time)
src-tauri/binaries/ormah-server-*

# Generated icon set (produced by `cargo tauri icon icons/icon.png`).
