# Rust / Tauri build output
src-tauri/target/
src-tauri/gen/

# Frozen sidecar binaries (produced by scripts/build-sidecar.sh at build time)
src-tauri/binaries/ormah-server-*

# Desktop icon set (small; committed so `cargo build` works on a fresh clone).
# Mobile icon sets are generated by `cargo tauri icon` and not used here.
src-tauri/icons/android/
src-tauri/icons/ios/

# PyInstaller scratch from build-sidecar.sh
/.build/
